# Required runtime environment. Copy this file to backend/.env.
APP_ENV=development

# Optional P1-T01 settings.
APP_NAME=AI Dashboard Agent API
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=dashboard_session
SESSION_TTL_SECONDS=28800
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# P0 read-only inspection of an existing database. A postgres admin login may
# be used only for this audit; the script starts a read-only transaction.
AUDIT_DATABASE_URL=

# P1-T02 database accounts. Use different PostgreSQL roles. Never commit values.
# Runtime may read/write app metadata but must not own schemas or have DDL rights.
RUNTIME_DATABASE_URL=
# Migration owns app/analytics schema changes and is never used by the API runtime.
# backup-db.ps1 rejects URL query/fragment options; set libpq options such as
# PGSSLMODE in the process environment when a backup requires them.
MIGRATION_DATABASE_URL=
# Set true only after scripts/backup-db.ps1 validates a fresh custom-format backup.
MIGRATION_BACKUP_VERIFIED=false

# P1-T03 login roles. Each login must be a member of exactly one NOLOGIN group
# role: analytics_reader_all, analytics_reader_ca, or analytics_reader_tx.
# There is deliberately no fallback scope and these principals must be distinct.
READER_ALL_DATABASE_URL=
READER_CA_DATABASE_URL=
READER_TX_DATABASE_URL=

# P2-T03 hard upper bounds: 5000 ms per statement and 1000 returned rows.
ANALYTICS_STATEMENT_TIMEOUT_MS=5000
ANALYTICS_MAX_ROWS=1000
# Provisional planner units; calibrate using EXPLAIN on the restored test DB.
# This value is not a duration or a price.
ANALYTICS_MAX_QUERY_COST=10000

# P1-T04 demo seed passwords (minimum 12 characters); never commit real values.
SEED_BUILDER_ALL_PASSWORD=
SEED_VIEWER_ALL_PASSWORD=
SEED_VIEWER_CA_PASSWORD=
SEED_BUILDER_TX_PASSWORD=

# P3-T01: mock never needs a key. Live configuration is explicit and has no
# default model/prices; verify provider/model prices before setting LLM_MODE=live.
LLM_MODE=mock
# LLM_PROVIDER=openai
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_MODEL=your-verified-model-id
# LLM_API_KEY=
# LLM_INPUT_PRICE_PER_MILLION=
# LLM_OUTPUT_PRICE_PER_MILLION=
# LLM_PRICING_SOURCE=
# LLM_PRICING_VERIFIED_ON=YYYY-MM-DD
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=4096
# A new multi-widget dashboard needs more room than a bounded edit response.
LLM_MAX_CREATION_OUTPUT_TOKENS=6144
LLM_MAX_CALLS_PER_RUN=3
LLM_MAX_TOKENS_PER_RUN=24000
LLM_TIMEOUT_SECONDS=60
LLM_BUDGET_PER_RUN_USD=0.10
LLM_BUDGET_PER_DAY_USD=1.00
# Prices must cover the highest applicable rate for the configured model/tier,
# including cache-write or regional surcharges where relevant. Estimates are
# conservative, not an invoice. Missing usage retains the full reservation.

