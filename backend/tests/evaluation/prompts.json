  "evaluation_policy": {
    "total_cases": 30,
    "required_categories": {"valid": 20, "ambiguous": 5, "unsupported": 5},
    "phase_2_kpis": ["sales_value", "transaction_count", "average_sale_value", "sold_property_count"],
    "phase_4_kpis": ["offer_count", "accepted_offer_rate", "repair_cost"],
    "allowed_dimensions": ["day", "month", "quarter", "year", "state", "city", "property_type", "agent"],
    "allowed_charts": ["card", "line", "bar", "horizontal_bar", "pie", "donut", "table"],
    "scoring": "Compare the structured oracle, authorization decision, scope, KPI grain, filters, time range and chart mapping; SQL merely executing is not a pass.",
    "valid_case_pass_requires": ["outcome", "kpis", "dimensions", "filters", "time", "sort", "limit", "widgets", "authorization", "sql_result"],
    "ambiguous_case_pass_requires": ["outcome", "reason_codes", "required_question", "must_not_generate_plan", "must_not_query", "authorization"],
    "unsupported_case_pass_requires": ["outcome", "reason_code", "explanation", "must_not_generate_plan", "must_not_query", "authorization"],
    "allowed_run_statuses": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"],
    "not_pass_statuses": ["BLOCKED", "NOT_RUN", "SKIPPED"],
    "manual_semantic_review": {
      "approved_on": "2026-10-19",
      "applies_only_to": ["ambiguous.required_question", "unsupported.explanation_must_include"],
      "requires": ["frozen_live_artifact_hash", "case_by_case_rationale", "correct_outcome_and_reason_codes", "correct_authorization_and_scope", "no_draft_or_query"],
      "cannot_override": ["raw_status", "valid_plan_diff", "sql_result", "authorization", "extra_or_missing_reason_code", "blocked_case"]
    },
    "authorization_order": "Authorization denial must happen before Agent or database execution.",
    "evidence_required": ["case_id", "mode", "provider_model_config", "actual_outcome", "plan_diff", "sql_result", "scope_authorization", "latency_ms", "status", "artifact"],
    "report_mock_and_live_separately": true,
    "phase_2_precheck": {"valid": 14, "ambiguous": 4, "unsupported": 5, "is_release_gate": false},
    "phase_4_full_run": {"valid": 20, "ambiguous": 5, "unsupported": 5, "valid_pass_threshold": 18},
    "phase_4_rule": "Cases tagged phase_4 are excluded from the Phase 3 sales-only pre-check and must be re-evaluated after Phase 4 KPI expansion."
  },
